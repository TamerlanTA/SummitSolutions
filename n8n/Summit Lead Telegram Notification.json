    {
      "parameters": {
        "jsCode": "const lead = $json.body?.lead || $json.lead || {};\nconst empty = (value) => {\n  if (value === undefined || value === null) return '—';\n  const text = String(value).trim();\n  return text.length ? text : '—';\n};\n\nconst leadId = empty(lead.id);\nconst messageText = [\n  'Новая заявка Summit Solutions',\n  '',\n  `Имя: ${empty(lead.name)}`,\n  `Телефон: ${empty(lead.phone)}`,\n  `Объект: ${empty(lead.objectType)}`,\n  `Тип работ: ${empty(lead.workType)}`,\n  `Высота: ${empty(lead.height)}`,\n  `Срочность: ${empty(lead.urgency)}`,\n  `Адрес: ${empty(lead.address)}`,\n  `Площадь: ${empty(lead.area)}`,\n  `Удобное время: ${empty(lead.preferredTime)}`,\n  `Комментарий: ${empty(lead.comment)}`,\n  `Источник: ${empty(lead.source)}`,\n  `ID заявки: ${leadId}`,\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      leadId,\n      messageText,\n      lead,\n    },\n  },\n];"
      },
