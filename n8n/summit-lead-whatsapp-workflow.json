        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: 'Unauthorized' } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "09f364e5-a9e0-4a89-91d2-80787c15e5fc",
      "name": "Unauthorized Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        -480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $json.body?.lead || $json.lead || {};\nconst empty = (value) => {\n  if (value === undefined || value === null) return '—';\n  const text = String(value).trim();\n  return text.length ? text : '—';\n};\n\nconst leadId = empty(lead.id);\nconst messageText = [\n  'Новая заявка Summit Solutions',\n  '',\n  `Имя: ${empty(lead.name)}`,\n  `Телефон: ${empty(lead.phone)}`,\n  `Объект: ${empty(lead.objectType)}`,\n  `Тип работ: ${empty(lead.workType)}`,\n  `Высота: ${empty(lead.height)}`,\n  `Срочность: ${empty(lead.urgency)}`,\n  `Адрес: ${empty(lead.address)}`,\n  `Площадь: ${empty(lead.area)}`,\n  `Удобное время: ${empty(lead.preferredTime)}`,\n  `Комментарий: ${empty(lead.comment)}`,\n  `Источник: ${empty(lead.source)}`,\n  `ID заявки: ${leadId}`,\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      leadId,\n      messageText,\n      lead,\n    },\n  },\n];"
      },
      "id": "530b0168-447d-472d-acd1-3784e019d7d0",
      "name": "Build WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{$env.WHATSAPP_CLOUD_PHONE_NUMBER_ID}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.WHATSAPP_CLOUD_ACCESS_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { messaging_product: 'whatsapp', to: $env.WHATSAPP_RECIPIENT_ID, type: 'text', text: { body: $json.messageText } } }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "ef37dc06-8e26-4714-8c90-9caa4e0f1db3",
      "name": "Send WhatsApp Cloud API Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
