      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "98d92733-2cf4-4665-a0f5-27f17938d37d",
              "leftValue": "={{ (($json.statusCode >= 200 && $json.statusCode < 300) || !!$json.body?.messages) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "fb4dbed8-ef6d-4456-8334-3e72cc11782b",
      "name": "WhatsApp Send Succeeded",
