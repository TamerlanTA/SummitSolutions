          },
          "conditions": [
            {
              "id": "3b37a517-0e4f-44ed-8c5d-2f61cb23f901",
              "leftValue": "={{ $json.headers['x-lead-webhook-secret'] || $json.headers['X-Lead-Webhook-Secret'] || '' }}",
