# Vercel/local mode for lead handling.
# Keep LEADS_BACKEND_MODE=stub until Supabase, n8n and WhatsApp are ready.
LEADS_BACKEND_MODE=stub
LEADS_LANGUAGE=ru
LEADS_FAILURE_MODE=failed

# Supabase. Use the service role key only on the server/Vercel env, never in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads

# n8n webhook that will receive the saved lead ID and full payload.
N8N_LEAD_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_SECRET=

# WhatsApp Cloud API. Target is a working WhatsApp group when the WABA account supports it.
WHATSAPP_PROVIDER=cloud_api
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_GROUP_ID=
